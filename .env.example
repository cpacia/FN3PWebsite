# ----- Front9 (league data via the public API; no auth required) -----
# API base, including the /api/public/v1 prefix.
FRONT9_API_URL=https://api.front9.com/api/public/v1
# FN3P's organization URL slug on Front9. Defaults to "fn3p-golf" when blank;
# set it to point the site at another org's data during development.
FRONT9_ORG_SLUG=fn3p-golf
# Id of the tour's season-points standings series (home page snippet and
# /tour). Leave blank to auto-detect the first season-scoped, non-money series
# that isn't linked to an indoor league.
SEASON_STANDINGS_SERIES_ID=

# ----- Shopify Storefront (apparel, tour entry, GHIN, Phoenix trip) -----
SHOPIFY_STORE_DOMAIN=www.fn3pgolf.com
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2024-10
# Collection handle backing the home page "The Drop" rail.
SHOPIFY_DROP_COLLECTION=2026-collection

# ----- Seasonal mode -----
# Two independent switches. Both are read when the page is prerendered or
# revalidated, so a change takes effect on the next build or within the page's
# 5-minute revalidate window -- not on server restart.
#
# Content: which half leads the home page.
# Unset = derive from the current month (tour Apr-Oct, apparel Nov-Mar).
# Set to "tour" or "apparel" to pin it.
SEASON_MODE_OVERRIDE=
# Look: which print and palette the site wears. Unset = follow the season
# ("palm-aqua" in season, "lone-pine" in the offseason). Pin it to give a drop
# its own print without reordering the page: "palm-aqua", "lone-pine", or
# "casco-bay" (the wave print -- offseason family, no season leads with it).
# See lib/print-theme.ts.
PRINT_THEME_OVERRIDE=

# ----- Site -----
NEXT_PUBLIC_SITE_URL=https://www.fn3pgolf.com
