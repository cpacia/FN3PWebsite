# ----- Front9 (league data via the public API; no auth required) -----
# API base, including the /api/public/v1 prefix.
FRONT9_API_URL=https://api.front9.com/api/public/v1
# FN3P's organization URL slug on Front9.
#
# NOTE: as of this writing the org does not exist yet — "fn3p", "fn3p-golf" and
# "fn3pgolf" all return ORG_NOT_FOUND. Leave this blank until it's created; every
# Front9-backed section degrades to empty rather than erroring (see
# front9OrgBase() in lib/providers/config.ts).
FRONT9_ORG_SLUG=
# Id of the season-points standings series, for the home page top-5 snippet.
# Leave blank to auto-detect the first season-scoped, non-money series.
SEASON_STANDINGS_SERIES_ID=

# ----- Shopify Storefront (apparel, tour entry, GHIN, Phoenix trip) -----
SHOPIFY_STORE_DOMAIN=www.fn3pgolf.com
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2024-10
# Collection handle backing the home page "The Drop" rail.
SHOPIFY_DROP_COLLECTION=2026-collection

# ----- Seasonal mode -----
# The home page leads with the tour in season and with apparel in the offseason.
# Unset = derive from the current month (tour Apr-Oct, apparel Nov-Mar).
# Set to "tour" or "apparel" to pin it.
SEASON_MODE_OVERRIDE=

# ----- Site -----
NEXT_PUBLIC_SITE_URL=https://www.fn3pgolf.com
